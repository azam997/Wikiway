<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the NuGet Lumina, run against Dalamud's bundled copy.
         Versions here should track the DLLs in XIVLauncher\addon\Hooks\dev. -->
    <PackageReference Include="Lumina" Version="7.6.0" ExcludeAssets="runtime" />
    <PackageReference Include="Lumina.Excel" Version="7.5.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wikiway.Core\Wikiway.Core.csproj" />
  </ItemGroup>

</Project>
